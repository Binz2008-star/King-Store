<section class="king-store-hero"><div class="king-store-hero__inner page-width"><div class="king-store-hero__content"><p class="king-store-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p><div class="king-store-hero__logo-wrap"><img src="{{ 'king-store-logo.svg' | asset_url }}" alt="King Store L.L.C" class="king-store-hero__logo" width="520" height="460" loading="eager"></div><h1 class="king-store-hero__heading">{{ section.settings.heading | escape }}</h1><div class="king-store-hero__text">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button button--primary king-store-hero__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div></div></section>
{% schema %}{"name":"King Store hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"KING STORE L.L.C"},{"type":"text","id":"heading","label":"Heading","default":"Elevated style, curated for the UAE"},{"type":"richtext","id":"text","label":"Text","default":"<p>Discover beauty, style and lifestyle pieces selected with a modern UAE customer in mind.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Explore the collection"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"King Store hero"}]}{% endschema %}